# --- dependencies (reinstall via _tools/package.json: npm install --prefix _tools) ---
_tools/node_modules/

# --- caches / transient artifacts ---
__pycache__/
*.pyc
*_r2k.jpg
*_r2k.png
*.pad.tmp
*.part
Thumbs.db
desktop.ini

# --- machine-local: kit_env.json holds THIS machine's private paths; never track
#     it. Copy _tools/kit_env.template.json to _tools/kit_env.json and edit. ---
_tools/kit_env.json

# --- PRIVATE BOOK WORKSPACES: never track a real book by default.
#     testvoyage (the generic proof book) is the tracked exception; to publish
#     another example book, add a matching !negation for it here. ---
book_workspace/*
!book_workspace/testvoyage

# --- session-recovery artifacts: regenerable from the session .jsonl and may
#     contain personal transcript content — never track, never ship ---
_REHYDRATION.md
**/_REHYDRATION.md
_CONTINUITY.snapshot.md
**/_CONTINUITY.snapshot.md
.booksmith_rehydrate

# --- personal-data + stray root artifacts: memory dumps, session logs, and
#     harness-local state carry the author's private transcript/identity and
#     must never enter git. make_giftable.py's scrub guards only the ZIP path,
#     so git needs its own guard here. ---
_SESSION_MEMORY_*.md
SESSION_LOG.md
.recall/
.claude/settings.json
.claude/settings.local.json
# bad-redirect artifact: a literal-colon filename left by a mangled shell
# redirect (e.g. `C:BOOKSMITH_...js`) — never a real source file
C:*
# third-party service-return PDFs dropped at the repo root (Blurb/KDP digest
# proofs etc.); keep them locally as evidence, never commit them
/Digest_*.pdf

# --- this-session audit/fix scratch: records of the kit-hardening campaign,
#     kept locally for provenance but not kit deliverables — never commit ---
_KIT_AUDIT_*.md
_tools/_fixplan/
# stray reference screenshots left by prior verification sessions (regenerable)
_refcheck/
# lessons staging: auto-drafted candidate lessons (ledger_stage.py) awaiting human
# endorsement + promotion into LESSONS_LEDGER.md; regenerable scratch, never shipped
docs/_lessons_staging.md
# pre-edit safety snapshots (belt-and-suspenders backups taken before risky edits; local)
_snapshots/
# engine runtime state (engine.py owns it; regenerable, per-machine; never track)
**/_engine/
# prerendered cover-catalog IMAGES: large + regenerable (hypergen renders live;
# SDXL via catalog_build on a GPU box). The manifest cover_catalog/catalog.json IS
# tracked; a curated image subset ships via make_giftable or `git add -f`.
cover_catalog/covers/
cover_catalog/thumbs/
# public-release scrub: other-project lesson-mining deltas + third-party service
# PDFs (Mixam guide + dielines). Kept locally for reference; never shipped public.
docs/_lessons_audit/
docs/service_templates/*.pdf

# --- distribution build output (make_giftable.py) ---
dist/

# --- large regenerable outputs inside tracked example books ---
book_workspace/*/outputs/**/*.pdf.bak
book_workspace/*/manuscript/drafts/*_wip_*
# assemble_manuscript.py re-derives the version-pinned master on every build;
# these accumulate untracked and are never the source of truth — regenerate,
# don't commit. (The ONE curated proof set already tracked for testvoyage
# stays tracked; this only stops NEW versions from leaking in.)
book_workspace/*/outputs/markdown/*_v*.md

# --- model weights: fetch_weights.py / fetch_weights 'sdxl' downloads multi-GB
#     .safetensors checkpoints. A stranger must never accidentally commit these
#     (they are re-downloadable and would bloat every clone). ---
checkpoints/
**/checkpoints/
*.safetensors
*.ckpt
_handoff/

# --- chunker organ (2026-08-02): the vendored TOOL under _tools/chunker/ is
#     tracked; its chunk OUTPUT dirs are per-book source material (personal
#     transcripts, corpus slices) and must never enter git. The root /chunker/
#     is the operator's ad-hoc working copy of the same tool — local only. ---
_tools/chunker/_*_chunks/
/chunker/

# --- intake drop zone (2026-08-02): contents are per-book private source and
#     never ship; only the drop-zone README is tracked. Prior builds' intake
#     material is preserved locally under _intake_archive/ (never committed). ---
intake/*
!intake/README_DROP_ZONE.md
_intake_archive/
